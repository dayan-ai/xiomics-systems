# Template for local development secrets. Copy to `.dev.vars` (git-ignored) only on your own machine.
# Production values are stored with `wrangler secret put <NAME>`, never in any file in this repository.
# Every value below is a placeholder.

# Zoho API console → Self Client → Client ID / Client Secret
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# Long-lived refresh token with scope ZohoMail.messages.CREATE (created once with scripts/zoho-oauth-setup.mjs)
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# Numeric Zoho Mail accountId of contact@xiomics.systems (printed by the setup script)
ZOHO_ACCOUNT_ID=your-zoho-account-id

# Cloudflare Turnstile secret key. Required: without it the Worker refuses to send (503).
TURNSTILE_SECRET=your-turnstile-secret

# Local testing only — never use these in production:
# ALLOWED_ORIGINS=http://localhost:8788
# TURNSTILE_REQUIRED=false
